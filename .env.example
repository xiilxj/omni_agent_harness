# Omni Agent Harness - 环境变量配置模板
# 请将此文件重命名为 .env，并填入您的真实 API 密钥

# DeepSeek 官方 API 密钥 (获取地址: https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# OpenAI 官方 API 密钥 (可选)
OPENAI_API_KEY=

# Anthropic Claude API 密钥 (可选)
ANTHROPIC_API_KEY=

# Google Gemini 官方 API 密钥 (可选)
GEMINI_API_KEY=

# Telegram 远程控制机器人配置 (可选)
# 1. Telegram Bot Token (从 Telegram @BotFather 获取)
TELEGRAM_BOT_TOKEN=
# 2. 允许控制机器人的 Telegram User ID 白名单 (逗号分隔，如 123456789,987654321；留空则不限制)
TELEGRAM_ALLOWED_USERS=

